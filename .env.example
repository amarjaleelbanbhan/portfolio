# ── Supabase ────────────────────────────────────────────────────────────────
# The publishable key is public by design: it identifies the project and
# authorises nothing. Every permission comes from row-level security. It ships
# in the client bundle, which is correct.
NEXT_PUBLIC_SUPABASE_URL=https://yokgnzxwrbymarjdfyhk.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only. Read at request time inside pages/api/** and never imported by
# anything the browser loads. Currently used by /api/site-config, which returns
# an empty projection and falls back to compiled defaults when it is absent —
# so leaving this unset is a safe default, not a broken one.
#
# NEVER prefix this with NEXT_PUBLIC_. NEVER commit a real value.
SUPABASE_SECRET_KEY=

# ── Optional ────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
